---
interface Props { size?: string; tagline?: boolean; href?: string; as?: 'a' | 'span' | 'p' }
const { size = '20px', tagline = false, href, as = href ? 'a' : 'span' } = Astro.props;
const Tag = as;
---
<Tag class="wordmark" style={`font-size:${size}`} href={href} aria-label="Raml KQL">RAML KQL</Tag>
{tagline && (
  <p class="tagline">Multi-tenant<span class="dot" aria-hidden="true">·</span>KQL<span class="dot" aria-hidden="true">·</span>Open source</p>
)}
<style>
  .tagline {
    margin: 12px 0 0; font: 400 13px / 1.4 var(--font-sans); letter-spacing: 0.14em; color: var(--graphite);
  }
</style>
