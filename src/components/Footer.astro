---
import Wordmark from './Wordmark.astro';
import { repoUrl } from '../lib/release';
---
<footer class="site-footer">
  <div class="wrap">
    <p class="line">
      <Wordmark as="span" size="14px" /><span class="dot" aria-hidden="true">·</span>Built by Luca Ramseyer<span class="dot" aria-hidden="true">·</span><a href="https://raml.ch">raml.ch</a>
    </p>
    <nav aria-label="Footer">
      <a href={repoUrl}>GitHub</a>
      <a href={`${repoUrl}/issues`}>Issues</a>
      <a href={`${repoUrl}/blob/main/LICENSE`}>MIT licence</a>
      <a href={`${repoUrl}/blob/main/SECURITY.md`}>Security</a>
    </nav>
    <p class="legal">Raml KQL is not affiliated with, endorsed by or sponsored by Microsoft. “Microsoft”, “Azure”, “Defender”, “Sentinel” and “Visual Studio Code” are trademarks of Microsoft. This site sets no cookies and runs no analytics.</p>
  </div>
</footer>
