---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Page not found">
  <section class="wrap measure" style="padding-block: var(--s8) var(--s6)">
    <p class="eyebrow">404</p>
    <h1>This page does not exist</h1>
    <p style="margin-top: var(--s3)">It may have moved when the docs were reorganised. Try the <a href={`${base}docs/`}>documentation index</a>, search the docs, or <a href={base}>go back to the start</a>.</p>
  </section>
</Base>
